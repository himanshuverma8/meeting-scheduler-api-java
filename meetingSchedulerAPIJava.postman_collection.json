          "name": "updateEventType",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "duration:-100 is a deliberate validation-failure test — @Positive on UpdateEventTypeRequest should reject it with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\"duration\":-100}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/event-types/:eventTypeId",
              "host": ["{{baseUrl}}"],
