              "raw": "{\"scheduleId\":\"{{scheduleId}}\",\"name\":\"30 Min Meeting\",\"duration\":30,\"bufferBefore\":10,\"bufferAfter\":10,\"minNoticeMinutes\":0,\"maxDaysInAdvance\":30}",
              "options": { "raw": { "language": "json" } }
