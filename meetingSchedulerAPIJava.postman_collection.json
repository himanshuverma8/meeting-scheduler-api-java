      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "getAvailability",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "description": "/availability is public (permitAll) — no token required, unlike Schedules/EventTypes.",
            "url": {
              "raw": "{{baseUrl}}/availability?eventTypeId={{eventTypeId}}&startDate=2026-07-23T00:00:00Z&endDate=2026-07-28T00:00:00Z&inviteeTimezone=America/New_York",
              "host": ["{{baseUrl}}"],
              "path": ["availability"],
              "query": [
                { "key": "eventTypeId", "value": "{{eventTypeId}}" },
                { "key": "startDate", "value": "2026-07-23T00:00:00Z" },
                { "key": "endDate", "value": "2026-07-28T00:00:00Z" },
                { "key": "inviteeTimezone", "value": "America/New_York" }
              ]
            }
          },
          "response": []
        }
      ]
    },
